---
import TubaLayout from '../layouts/TubaLayout.astro';

const words = ['Research.', 'Build.', 'Invest.'];
---

<TubaLayout>
  <section class="tuba-hero" aria-labelledby="tuba-title">
    <div class="tuba-statement">
      <p class="tuba-eyebrow"><span>AI agent-driven</span><i aria-hidden="true">/</i><span>On-chain</span></p>
      <h1 id="tuba-title" class="tuba-title">
        <span class="tuba-sr-only">Research. Build. Invest.</span>
        <span class="tuba-typewriter" aria-hidden="true">
          {words.map(word => <span class="tuba-type-line" data-type-line>
            <span class="tuba-type-reserve">{word}</span>
            <span class="tuba-type-ink"><span data-type-word>{word}</span><i class="tuba-cursor"></i></span>
          </span>)}
        </span>
      </h1>
      <p class="tuba-thesis">Intelligence into action.<br />Capital on-chain.</p>
    </div>

    <div class="tuba-system" aria-hidden="true">
      <svg class="tuba-system-graphic" viewBox="0 0 540 560" fill="none" xmlns="http://www.w3.org/2000/svg">
        <g class="tuba-guides">
          <path d="M270 20V530M30 180H510M30 390H510" />
          <path d="M30 176V184M510 176V184M266 20H274M266 530H274M30 386V394M510 386V394" />
        </g>
        <g class="tuba-network">
          <path d="M270 80L357 130V230L270 280L183 230V130Z" />
          <path d="M270 80V180M357 130L270 180L183 130M357 230L270 180L183 230M270 180V280" />
          <path d="M270 80L357 230H183L270 80ZM183 130H357L270 280Z" />
          <path d="M183 130L126 98M357 130L414 98M183 230L126 262M357 230L414 262M270 80V48" />
          <circle cx="270" cy="180" r="30" />
          <circle cx="270" cy="180" r="50" class="tuba-network-orbit" />
        </g>
        <g class="tuba-nodes">
          <circle cx="270" cy="80" r="4" /><circle cx="357" cy="130" r="4" />
          <circle cx="357" cy="230" r="4" /><circle cx="270" cy="280" r="4" />
          <circle cx="183" cy="230" r="4" /><circle cx="183" cy="130" r="4" />
          <circle cx="126" cy="98" r="2.5" /><circle cx="414" cy="98" r="2.5" />
          <circle cx="126" cy="262" r="2.5" /><circle cx="414" cy="262" r="2.5" />
          <circle cx="270" cy="48" r="2.5" />
        </g>
        <g class="tuba-chain">
          <path d="M270 330L410 410L270 490L130 410Z" />
          <path d="M270 302L410 382L270 462L130 382Z" />
          <path d="M270 274L410 354L270 434L130 354Z" />
          <path d="M130 354V410M410 354V410M270 434V490" />
          <path d="M270 310L347 354L270 398L193 354Z" class="tuba-chain-inner" />
        </g>
        <path class="tuba-signal-track" d="M270 180V274L410 354L270 434L130 354L270 274" />
        <path class="tuba-signal" d="M270 180V274L410 354L270 434L130 354L270 274" pathLength="100" />
        <g class="tuba-core">
          <path d="M270 169L280 175V186L270 192L260 186V175Z" />
          <circle cx="270" cy="274" r="3" />
        </g>
      </svg>
      <div class="tuba-system-caption"><span>Agent-driven</span><span class="tuba-caption-line"></span><span>On-chain</span></div>
    </div>

  </section>
</TubaLayout>

<script>
  import '../scripts/tuba';
</script>
