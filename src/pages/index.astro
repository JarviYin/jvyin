---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubscribeForm from '../components/SubscribeForm.astro';
import ResearchList from '../components/ResearchList.astro';
import { getNewsletters } from '../lib/newsletters';
import { getSnapshot, shortDate } from '../lib/landscape';
import { entities } from '../data/ecosystem';
import { site } from '../site.config';
import { aiProducts } from '../data/ai-agents';
import ChainFlow from '../components/ChainFlow.astro';
const newsletters=getNewsletters().slice(0,4);
const agentCount=entities.filter(entity=>entity.pages.includes('agents')).length + aiProducts.length;
const financeCount=entities.filter(entity=>entity.pages.includes('finance')).length;
const financeSnapshot=getSnapshot('finance');
const agentReviewDate = aiProducts.map(product => product.reviewedAt).sort().at(-1)!;
---
<BaseLayout width="wide"><div class="overview-intro"><p class="editorial-kicker">INTELLIGENCE &amp; CAPITAL</p><span>INDEPENDENT RESEARCH / JVYIN</span></div><section class="overview-head" aria-labelledby="overview-title"><img class="avatar" src="/avatar.jpg" alt="Jv家伟 的头像" width="56" height="56" /><div><h1 id="overview-title">{site.title}</h1><p>{site.tagline}</p></div><div class="overview-socials">{site.socials.map(social=><a href={social.href} target={social.href.startsWith('http')?'_blank':undefined} rel={social.href.startsWith('http')?'noopener noreferrer':undefined}>{social.label}</a>)}</div><div class="overview-manifesto" aria-label="Research. Build. Invest."><span>Research.</span><span>Build.</span><em>Invest.</em></div></section><ChainFlow /><section class="overview-layout"><div><section class="section section-first" aria-labelledby="data-title"><div class="section-heading"><h2 id="data-title">Data</h2><span class="section-note">公开资料与核验日期</span></div><div class="data-list"><a href="/agents/"><div><h3>AI agents</h3><p>Claude、GPT、DeepSeek、Grok Bot。产品、数据与前沿动态。</p></div><span><b>{agentCount}</b> 项 · {shortDate(agentReviewDate)}<i aria-hidden="true">→</i></span></a><a href="/onchain-finance/"><div><h3>链上金融</h3><p>稳定币、DeFi、RWA 与市场基础设施。</p></div><span><b>{financeCount}</b> 项 · {shortDate(financeSnapshot.observedAt)}<i aria-hidden="true">→</i></span></a></div></section><section class="section" aria-labelledby="research-title"><div class="section-heading"><h2 id="research-title">Latest research</h2><a class="text-link" href="/research/">All research</a></div><ResearchList items={site.research} /></section></div><aside class="overview-aside"><section aria-labelledby="newsletter-title"><div class="section-heading"><h2 id="newsletter-title">Newsletter</h2><a class="text-link" href="/newsletter/">Archive</a></div><div class="issue-table">{newsletters.length?newsletters.map(issue=><a href={`/newsletter/${issue.id}/`}><time datetime={issue.pubDate}>{issue.pubDate}</time><strong>{issue.title}</strong><i aria-hidden="true">→</i></a>):<p class="muted">还没有发布任何一期。</p>}</div></section><SubscribeForm /></aside></section></BaseLayout>
